{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "default",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/keeper/**)",
      "Read(/run/media/veracrypt*/**)",
      "Read(**/*.vc)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.gnupg/*)",
      "Bash(ssh-keygen*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(sudo*)"
    ],
    "ask": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
